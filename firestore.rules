rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Gestion de la collection des utilisateurs
    match /users/{userId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Produits & Annonces de la marketplace SamaDeal
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Collection des annonces (Listings)
    match /listings/{listingId} {
      allow read: if true;
      allow create, update, delete: if true;
    }
  }
}
